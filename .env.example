# Copy to .env (never commit it) or set these in your host's dashboard.

# Firebase service account JSON (Project settings → Service accounts → Generate new private key).
# Paste the whole JSON, or base64 of it:  base64 -w0 key.json
FIREBASE_SERVICE_ACCOUNT=

# Firebase web app config (Project settings → General → Your apps → Config). This one is public.
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}

# Optional: only allow the game to be opened from these origins (comma separated)
ALLOWED_ORIGINS=https://your-game.onrender.com

PORT=8080
