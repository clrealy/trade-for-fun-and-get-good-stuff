rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players can read their own profile. Only the game server (Admin SDK) can write,
    // so nobody can give themselves coins or items from the browser.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
